{
  "name": "Scorewing Rust + Tauri",
  "build": { "dockerfile": "Containerfile", "context": ".." },
  "remoteUser": "ubuntu",
  "containerUser": "ubuntu",
  "updateRemoteUserUID": true,
  "runArgs": ["--userns=keep-id"],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "containerEnv": {
    "CARGO_HOME": "/home/ubuntu/.cargo",
    "CARGO_TARGET_DIR": "/home/ubuntu/.cache/scorewing-target"
  },
  "mounts": [
    "source=scorewing-cargo-registry,target=/home/ubuntu/.cargo/registry,type=volume",
    "source=scorewing-cargo-git,target=/home/ubuntu/.cargo/git,type=volume",
    "source=scorewing-target,target=/home/ubuntu/.cache/scorewing-target,type=volume"
  ],
  "forwardPorts": [1420],
  "customizations": { "vscode": { "extensions": ["rust-lang.rust-analyzer", "tauri-apps.tauri-vscode"] } }
}

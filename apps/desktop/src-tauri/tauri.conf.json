{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MXML",
  "version": "0.1.0",
  "identifier": "org.mxml.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MXML",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; img-src 'self' asset: data:",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Merge and split MusicXML instruments",
    "longDescription": "Inspect MusicXML scores, merge instruments, and split chord tones or voices into new parts.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libxml2",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0 | libgtk-3-0t64"
        ]
      },
      "rpm": { "depends": ["libxml2", "webkit2gtk4.1", "gtk3"] }
    }
  }
}
